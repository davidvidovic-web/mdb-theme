{
  "name": "mdb-theme",
  "version": "1.0.0",
  "description": "SCSS compilation for MDB WordPress Theme",
  "main": "index.js",
  "scripts": {
    "sass": "sass assets/scss:assets/css --style=expanded --source-map",
    "sass:watch": "sass assets/scss:assets/css --style=expanded --source-map --watch",
    "sass:production": "sass assets/scss:assets/css --style=compressed --no-source-map",
    "build": "npm run sass:production",
    "dev": "npm run sass:watch"
  },
  "devDependencies": {
    "sass": "^1.101.0"
  },
  "keywords": [
    "wordpress",
    "theme",
    "scss",
    "sass"
  ],
  "author": "David Vidovic",
  "license": "GPL-3.0"
}
